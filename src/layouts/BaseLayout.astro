---
import '../styles/global.css'
import SectionNav from '../components/ui/SectionNav.astro'
import Cursor from '../components/ui/Cursor.astro'
import pastel from '../assets/pastel.webp'
import Loader from '../components/ui/Loader.astro'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Riccardo Canella — Independent Software Architect',
  description = 'Personal site of Riccardo Canella, Independent Software Architect.',
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <!-- Loading screen only with JS: without it nothing waits. -->
    <script is:inline>
      document.documentElement.classList.add('is-loading')
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="author" content="Riccardo Canella" />
    <meta name="theme-color" content="#0a0a0c" />

    <!-- OG -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://canellariccardo.it" />
    <meta property="og:image" content="https://canellariccardo.it/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://canellariccardo.it/og.png" />

    <!-- Fonts (non-render-blocking) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript
      ><link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Instrument+Serif:ital@0;1&display=swap"
      /></noscript
    >

    <!-- Favicons -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Google Analytics (async, non-blocking) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QEZ5WE0ZJR"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || []
      function gtag() {
        // eslint-disable-next-line prefer-rest-params
        dataLayer.push(arguments)
      }
      gtag('js', new Date())
      gtag('config', 'G-QEZ5WE0ZJR')
    </script>

    <title>{title}</title>
  </head>
  <body>
    <Loader />
    <!-- Pastel watercolour of the intro, fades into the night background -->
    <div class="pastel" aria-hidden="true">
      <img id="pastel-img" src={pastel.src} alt="" decoding="async" fetchpriority="high" />
    </div>

    <!-- Holographic surfaces under the content (WebGL, loaded async) -->
    <canvas id="holo" aria-hidden="true"></canvas>

    <!-- Scrolling content -->
    <div id="scroll">
      <slot />
    </div>

    <!-- The diamond (WebGL, loaded async) -->
    <canvas id="diamond" aria-hidden="true"></canvas>

    <SectionNav />

    <Cursor />

    <script>
      import '../scripts/stage/index'
    </script>
  </body>
</html>
