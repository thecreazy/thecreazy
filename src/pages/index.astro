---
// Imported as a module (not read from disk) so that the dev server reloads
// the page whenever the README changes.
import raw from '../../README.md?raw'
import { parseReadme } from '../lib/parseReadme'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/sections/Hero.astro'
import Projects from '../components/sections/Projects.astro'
import Blog from '../components/sections/Blog.astro'
import CV from '../components/sections/CV.astro'

const data = parseReadme(raw)

const ARTICLES = 5
const social = (label: string) => data.socials.find((s) => s.label === label)?.url
---

<BaseLayout>
  <main>
    <Hero hero={data.hero} socials={data.socials} />
    <Projects projects={data.projects} moreUrl={social('/github')} />
    <Blog posts={data.blog.slice(0, ARTICLES)} moreUrl={social('/blog')} />
    <CV entries={data.cv} />
  </main>
</BaseLayout>
