---
import { readFileSync } from 'node:fs'
import { join } from 'node:path'
import { parseReadme } from '../lib/parseReadme'
import BaseLayout from '../layouts/BaseLayout.astro'
import Hero from '../components/sections/Hero.astro'
import Projects from '../components/sections/Projects.astro'
import Blog from '../components/sections/Blog.astro'
import CV from '../components/sections/CV.astro'

const raw = readFileSync(join(process.cwd(), 'README.md'), 'utf-8')
const data = parseReadme(raw)

const FEATURED = 4
const social = (label: string) => data.socials.find((s) => s.label === label)?.url
---

<BaseLayout>
  <main>
    <Hero hero={data.hero} socials={data.socials} />
    <Projects projects={data.projects.slice(0, FEATURED)} moreUrl={social('/github')} />
    <Blog posts={data.blog.slice(0, FEATURED)} moreUrl={social('/blog')} />
    <CV entries={data.cv} />
  </main>
</BaseLayout>
