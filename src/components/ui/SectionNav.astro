---
const items = [
  { id: 'hero', label: 'intro' },
  { id: 'projects', label: 'what i code' },
  { id: 'blog', label: 'what i write' },
  { id: 'cv', label: 'my cv' },
]
---

<nav class="section-nav" aria-label="Page sections">
  {
    items.map((item) => (
      <a
        href={`#${item.id}`}
        class="nav-dot"
        data-nav-dot
        aria-label={item.label}
        title={item.label}
      />
    ))
  }
</nav>

<style>
  .section-nav {
    position: fixed;
    right: max(20px, env(safe-area-inset-right));
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    flex-direction: column;
    gap: 18px;
    z-index: 5;
  }

  .nav-dot {
    position: relative;
    display: block;
    width: 9px;
    height: 9px;
    border: 1px solid var(--fg);
    transform: rotate(45deg);
    opacity: 0.55;
    transition:
      background-color 0.25s,
      opacity 0.25s,
      transform 0.25s;
  }

  /* bigger hit area */
  .nav-dot::before {
    content: '';
    position: absolute;
    inset: -10px;
  }

  .nav-dot:hover,
  .nav-dot:focus-visible,
  .nav-dot.is-active {
    opacity: 1;
  }

  .nav-dot.is-active {
    background: var(--fg);
    transform: rotate(45deg) scale(1.25);
  }

  @media (max-width: 640px) {
    .section-nav {
      right: max(10px, env(safe-area-inset-right));
      gap: 14px;
    }

    .nav-dot {
      width: 7px;
      height: 7px;
    }
  }
</style>
