---
import type { Project } from '../../lib/types'

interface Props {
  projects: Project[]
  moreUrl?: string
}

const { projects, moreUrl } = Astro.props
---

<section id="projects" class="section">
  <header class="section-head">
    <p class="eyebrow">what i code</p>
    <h2>Selected <em>work</em></h2>
  </header>

  <ul class="items">
    {
      projects.map((p) => (
        <li>
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="item">
            <span class="item-title">{p.name}</span>
            <span class="item-sub">{p.description}</span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    moreUrl && (
      <a href={moreUrl} target="_blank" rel="noopener noreferrer" class="more">
        all projects →
      </a>
    )
  }
</section>
