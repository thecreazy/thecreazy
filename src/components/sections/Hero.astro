---
import type { HeroData, SocialLink } from '../../lib/types'

interface Props {
  hero: HeroData
  socials: SocialLink[]
}

const { hero, socials } = Astro.props

// "From Italy 🤌. I lead…" → short opener as eyebrow, the rest as intro text.
const [opener, ...rest] = hero.tagline.split(/(?<=\.)\s+/)
const intro = rest.join(' ')

const [first, ...others] = hero.name.split(' ')
const last = others.join(' ')

// Entrance: the intro appears word by word, then bullets and socials follow.
// Kept short: fast scrollers must still find the text already there.
const WORD_MS = 5
const words = intro.split(/\s+/).filter(Boolean)
const afterWords = words.length * WORD_MS + 60
const delay = (ms: number) => `--d: ${Math.round(ms)}ms`
---

<section id="hero" class="hero">
  <div class="hero-cover">
    <p class="eyebrow">{opener.replace(/\.$/, '')}</p>
    <h1>{first} <em>{last}</em></h1>
    <p class="scroll-hint eyebrow" aria-hidden="true">scroll ↓</p>
  </div>

  <div class="hero-about">
    <div data-reveal-group>
      {
        intro && (
          <p class="hero-intro">
            {words.map((w, i) => (
              <>
                <span class="word" data-reveal style={delay(i * WORD_MS)}>
                  {w}
                </span>{' '}
              </>
            ))}
          </p>
        )
      }

      <ul class="hero-bullets">
        {
          hero.bullets.map((b, i) => (
            <li data-reveal style={delay(afterWords + i * 50)}>
              {b}
            </li>
          ))
        }
      </ul>

      <nav class="socials" aria-label="Social links">
        {
          socials.map((s, i) => (
            <a
              href={s.url}
              target="_blank"
              rel="noopener noreferrer"
              data-reveal
              style={delay(afterWords + hero.bullets.length * 50 + i * 25)}
            >
              {s.label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<style>
  .hero-cover {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: center;
    text-align: center;
    padding: 0 8vw 8vh;
  }

  .hero-cover .eyebrow {
    margin-bottom: 0.6rem;
  }

  h1 {
    font-size: clamp(2.6rem, 8vw, 4.4rem);
    font-weight: 400;
    line-height: 1.05;
  }

  .scroll-hint {
    margin-top: 2.4rem;
    opacity: 0.5;
  }

  .hero-about {
    min-height: 100vh;
    min-height: 100svh;
    max-width: 760px;
    margin: 0 auto;
    padding: calc(var(--veil-h) + 8vh) 24px 16vh;
  }

  .hero-intro {
    font-size: clamp(1.35rem, 3.6vw, 1.7rem);
    line-height: 1.3;
  }

  .word {
    display: inline-block;
  }

  .hero-bullets {
    list-style: none;
    margin-top: 2.2rem;
    font-family: var(--font-mono);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .hero-bullets li + li {
    margin-top: 0.6rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.2rem;
    margin-top: 2.4rem;
    font-family: var(--font-mono);
    font-size: 0.88rem;
  }

  .socials a {
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .socials a:hover,
  .socials a:focus-visible {
    border-bottom-color: currentColor;
  }
</style>
