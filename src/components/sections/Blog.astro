---
import type { BlogPost } from '../../lib/types'

interface Props {
  posts: BlogPost[]
  moreUrl?: string
}

const { posts, moreUrl } = Astro.props

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '')
---

<section id="blog" class="section">
  <header class="section-head">
    <p class="eyebrow">what i write</p>
    <h2>Latest <em>articles</em></h2>
  </header>

  <ul class="items">
    {
      posts.map((post) => (
        <li>
          <a href={post.url} target="_blank" rel="noopener noreferrer" class="item">
            <span class="item-title">{post.title}</span>
            <span class="item-sub">
              {post.year} · {host(post.url)}
            </span>
          </a>
        </li>
      ))
    }
  </ul>

  {
    moreUrl && (
      <a href={moreUrl} target="_blank" rel="noopener noreferrer" class="more">
        all articles →
      </a>
    )
  }
</section>
