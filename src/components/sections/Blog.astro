---
import { Image } from 'astro:assets'
import type { BlogPost } from '../../lib/types'
import { articleImage, edgeTones, type EdgeTones } from '../../lib/articleImages'

interface Props {
  posts: BlogPost[]
  moreUrl?: string
}

const { posts, moreUrl } = Astro.props

const host = (url: string) => new URL(url).hostname.replace(/^www\./, '')
const pad = (n: number) => String(n).padStart(2, '0')
const NO_IMAGE: EdgeTones = { top: 'light', bottom: 'light', left: 'light', right: 'light' }

const articles = await Promise.all(
  posts.map(async (post) => {
    const cover = articleImage(post.title)
    return { post, cover, tones: cover ? await edgeTones(cover.file) : NO_IMAGE }
  })
)

// One run of the ticker: the title repeated, so a half-track is always
// wider than the frame; the track holds two identical halves to loop.
const run = (title: string) => Array(3).fill(title.toUpperCase()).join(' · ') + ' · '
const speed = (title: string) => `--dur: ${Math.round(title.length * 1.1)}s`
---

<section id="blog" class="writing">
  <!-- Heading + track share a wrapper: the heading stays pinned inside the
       diamond's opening for as long as the articles are pinned below it. -->
  <div class="writing-pinned">
    <header class="section-head writing-head">
      <p class="eyebrow">what i write</p>
      <h2>Latest <em>articles</em></h2>
    </header>

    <!-- Tall track: while it scrolls by, the stage stays pinned and the
       articles crossfade one per step. -->
    <div class="writing-track" data-articles-track style={`--count: ${articles.length}`}>
      <div class="stage" data-articles data-current={posts[0]?.title}>
        <div class="frames">
          {
            articles.map(({ post, cover, tones }, i) => (
              <div
                class:list={['article', { 'is-active': i === 0 }]}
                data-article
                data-title={post.title}
                data-url={post.url}
                aria-hidden={i !== 0 ? 'true' : undefined}
              >
                {cover ? (
                  <Image
                    src={cover.image}
                    alt=""
                    widths={[640, 960, 1280, 1920]}
                    sizes="(max-width: 640px) 92vw, 1000px"
                    class="article-img"
                    loading={i === 0 ? 'eager' : 'lazy'}
                  />
                ) : (
                  <span class="article-img article-img--empty" />
                )}

                {(['top', 'bottom', 'left', 'right'] as const).map((side) => (
                  <span class={`ticker ticker--${side} is-${tones[side]}`} aria-hidden="true">
                    <span class="ticker-track" style={speed(post.title)}>
                      <span>{run(post.title)}</span>
                      <span>{run(post.title)}</span>
                    </span>
                  </span>
                ))}

                <p class={`article-meta is-${tones.top}`}>
                  <span class="article-title">{post.title}</span>
                  <span>
                    {post.year} · {host(post.url)}
                  </span>
                  <span aria-hidden="true">
                    {pad(i + 1)} / {pad(articles.length)}
                  </span>
                </p>
              </div>
            ))
          }
        </div>

        <div class="stage-foot">
          <div class="article-steps" aria-hidden="true">
            {
              articles.map((_, i) => (
                <span
                  class="article-step"
                  data-article-step
                  aria-current={i === 0 ? 'true' : undefined}
                >
                  <span>{pad(i + 1)}</span>
                  <span class="article-step-bar" />
                </span>
              ))
            }
          </div>

          {
            posts[0] && (
              <a
                href={posts[0].url}
                target="_blank"
                rel="noopener noreferrer"
                class="read"
                data-article-read
                aria-label={`Read “${posts[0].title}”`}
              >
                read article <span aria-hidden="true">→</span>
              </a>
            )
          }
        </div>
      </div>
    </div>
  </div>

  {
    moreUrl && (
      <a href={moreUrl} target="_blank" rel="noopener noreferrer" class="all-articles">
        <span class="all-articles-label">all articles</span>
        <span class="all-articles-track" aria-hidden="true">
          {[0, 1].map(() => (
            <span>{Array(6).fill('ALL ARTICLES →').join('   ')}&nbsp;&nbsp;&nbsp;</span>
          ))}
        </span>
      </a>
    )
  }
</section>

<style>
  .writing {
    padding: 0 max(16px, 6vw) 18vh;
  }

  .writing-pinned {
    padding-top: calc(var(--veil-h) + 8vh);
  }

  .writing-head {
    margin-bottom: 12vh;
  }

  /* With the diamond: the heading scrolls up behind the frame and stops in
     its opening (--hole-*, measured by the diamond), sized to fit. */
  :global(.has-diamond) .writing-head {
    position: sticky;
    top: var(--hole-y);
    z-index: 1;
    width: calc(var(--hole-w) * 0.62);
    margin: 0 auto 12vh;
    transform: translateY(-50%);
  }

  :global(.has-diamond) .writing-head .eyebrow {
    margin-bottom: 0.3rem;
    font-size: clamp(0.6rem, calc(var(--hole-w) * 0.022), 0.8rem);
  }

  :global(.has-diamond) .writing-head h2 {
    font-size: clamp(1rem, calc(var(--hole-w) * 0.085), 3.4rem);
    white-space: nowrap;
  }

  /* One viewport to pin + ~45vh of scroll per article. */
  .writing-track {
    height: calc(100vh + var(--count) * 45vh);
  }

  /* Pinned a little under the diamond: its tip overlaps the frame. The
     content mask is lowered meanwhile (--lift, see stage/state.ts). */
  .stage {
    --band: clamp(15px, 2.4vw, 34px);
    --inset: clamp(6px, 0.8vw, 12px);
    position: sticky;
    top: calc(var(--veil-h) - 10vh);
    width: min(1200px, 100%, (100vh - var(--veil-h) + 5vh - 72px) * 1.905);
    margin: 0 auto;
  }

  .frames {
    position: relative;
    aspect-ratio: 1200 / 630;
    background: #101014;
  }

  /* ─── one article: cover + 4 tickers + meta ───────────────────────────── */

  .article {
    position: absolute;
    inset: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 1.1s ease;
  }

  .article.is-active {
    opacity: 1;
  }

  .article-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .article-img--empty {
    background: linear-gradient(135deg, #1b1b22, #0d0d10);
  }

  .ticker {
    position: absolute;
    overflow: hidden;
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-size: var(--band);
    line-height: 1;
    white-space: nowrap;
    pointer-events: none;
  }

  /* Text colour picked at build time from the photo under each side. */
  .is-light {
    color: #fff;
  }

  .is-dark {
    color: #111;
  }

  .ticker--top,
  .ticker--bottom {
    left: var(--inset);
    right: var(--inset);
    height: var(--band);
  }

  .ticker--top {
    top: var(--inset);
  }

  .ticker--bottom {
    bottom: var(--inset);
  }

  .ticker--left,
  .ticker--right {
    top: calc(var(--band) + var(--inset) * 2);
    bottom: calc(var(--band) + var(--inset) * 2);
    width: var(--band);
    writing-mode: vertical-rl;
  }

  .ticker--left {
    left: var(--inset);
    transform: rotate(180deg);
  }

  .ticker--right {
    right: var(--inset);
  }

  .ticker-track {
    display: inline-flex;
    animation: ticker var(--dur, 30s) linear infinite;
  }

  .ticker-track > span {
    padding-inline-end: 0.4em;
  }

  /* Every side runs on its own: different direction and pace. */
  .ticker--bottom .ticker-track {
    animation-direction: reverse;
    animation-duration: calc(var(--dur, 30s) * 1.2);
  }

  .ticker--left .ticker-track {
    animation-duration: calc(var(--dur, 30s) * 0.8);
  }

  .ticker--right .ticker-track {
    animation-direction: reverse;
    animation-duration: calc(var(--dur, 30s) * 0.9);
  }

  /* Logical translation: horizontal on top/bottom, vertical on the sides. */
  @keyframes ticker {
    from {
      translate: 0 0;
    }
    to {
      translate: -50% 0;
    }
  }

  .ticker--left .ticker-track,
  .ticker--right .ticker-track {
    animation-name: ticker-y;
  }

  @keyframes ticker-y {
    from {
      translate: 0 0;
    }
    to {
      translate: 0 -50%;
    }
  }

  .article-meta {
    position: absolute;
    top: calc(var(--band) + var(--inset) * 2.5);
    left: calc(var(--band) + var(--inset) * 2.5);
    right: calc(var(--band) + var(--inset) * 2.5);
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
  }

  .article-title {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      animation: none;
    }

    .article {
      transition: none;
    }
  }

  /* ─── step indicator: progress through the pinned track ─────────────── */

  .stage-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .article-steps {
    display: flex;
    gap: 1.2rem;
  }

  /* Read the article on screen: a solid tag, same type as the tickers. */
  .read {
    flex-shrink: 0;
    padding: 0.55rem 0.9rem;
    background: var(--paper);
    color: var(--night);
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-size: clamp(0.8rem, 1.3vw, 1rem);
    line-height: 1;
    text-transform: uppercase;
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .read:hover,
  .read:focus-visible {
    background: transparent;
    color: var(--paper);
    box-shadow: inset 0 0 0 1px var(--paper);
  }

  .read span {
    display: inline-block;
    transition: transform 0.2s;
  }

  .read:hover span,
  .read:focus-visible span {
    transform: translateX(4px);
  }

  .article-step {
    position: relative;
    padding: 0.3rem 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    opacity: 0.45;
    transition: opacity 0.3s;
  }

  .article-step[aria-current='true'] {
    opacity: 1;
  }

  .article-step-bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    transform: scaleX(0);
  }

  .article-step[aria-current='true'] .article-step-bar {
    transform: scaleX(var(--progress, 1));
  }

  /* ─── all articles: a full-bleed ticker, same language as the frame ──── */

  .all-articles {
    display: block;
    margin: 10vh calc(-1 * max(16px, 6vw)) 0;
    padding: 0.9rem 0;
    overflow: hidden;
    border-block: 1px solid color-mix(in srgb, var(--paper) 35%, transparent);
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-size: clamp(1.6rem, 4.4vw, 3.6rem);
    line-height: 1;
    white-space: nowrap;
    transition:
      background-color 0.25s,
      color 0.25s;
  }

  .all-articles:hover,
  .all-articles:focus-visible {
    background: var(--paper);
    color: var(--night);
  }

  .all-articles-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .all-articles-track {
    display: inline-flex;
    animation: ticker 40s linear infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .all-articles-track {
      animation: none;
    }
  }
</style>
