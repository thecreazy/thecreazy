---
import type { CVEntry } from '../../lib/types'

interface Props {
  entries: CVEntry[]
}

const { entries } = Astro.props

const sub = (e: CVEntry) => [e.role, e.period.replace(' - ', ' – ')].filter(Boolean).join(' · ')
---

<section id="cv" class="section cv">
  <header class="section-head">
    <p class="eyebrow">my cv</p>
    <h2>The <em>path</em> so far</h2>
  </header>

  <ul class="items">
    {
      entries.map((e) => (
        <li>
          {e.url ? (
            <a href={e.url} target="_blank" rel="noopener noreferrer" class="item">
              <span class="item-title">{e.company}</span>
              <span class="item-sub">{sub(e)}</span>
            </a>
          ) : (
            <div class="item">
              <span class="item-title">{e.company}</span>
              <span class="item-sub">{sub(e)}</span>
            </div>
          )}
        </li>
      ))
    }
  </ul>

  <a href="https://thecreazy.link/github" target="_blank" rel="noopener noreferrer" class="more">
    full cv →
  </a>
</section>

<style>
  /* Leave room for the diamond's exit before the page ends. */
  .cv {
    min-height: 140vh;
    min-height: 140svh;
  }
</style>
