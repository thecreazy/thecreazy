---
import type { CVEntry } from '../../lib/types'

interface Props {
  entries: CVEntry[]
}

const { entries } = Astro.props

const period = (e: CVEntry) => e.period.replace(' - ', ' – ')
const sub = (e: CVEntry) => [e.role, period(e)].filter(Boolean).join(' · ')
---

<section id="cv" class="cv" style={`--count: ${entries.length}`}>
  <div class="cv-pin">
    <div class="cv-copy">
      <header class="cv-head">
        <p class="eyebrow">my cv</p>
        <h2>The <em>path</em> so far</h2>
      </header>

      <ol class="cv-list" data-cv-list>
        {
          entries.map((e) => (
            <li
              class="cv-entry"
              data-cv-entry
              data-company={e.company}
              data-period={period(e) || ' '}
            >
              {e.url ? (
                <a href={e.url} target="_blank" rel="noopener noreferrer" class="cv-company">
                  {e.company}
                </a>
              ) : (
                <span class="cv-company">{e.company}</span>
              )}
              <span class="cv-sub">{sub(e)}</span>
            </li>
          ))
        }
      </ol>

      <a href="https://thecreazy.link/github" target="_blank" rel="noopener noreferrer" class="more">
        full cv →
      </a>
    </div>
  </div>
</section>

<style>
  /* ─── default: plain list (no WebGL) ─────────────────────────────────── */

  .cv {
    min-height: 100vh;
    min-height: 100svh;
    padding: calc(var(--veil-h) + 8vh) max(24px, 8vw) 18vh;
  }

  .cv-copy {
    max-width: 460px;
    margin: 0 auto;
  }

  .cv-head {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .cv-head .eyebrow {
    margin-bottom: 0.6rem;
  }

  .cv-head h2 {
    font-size: clamp(2.2rem, 6vw, 3.4rem);
    font-weight: 400;
    line-height: 1.1;
  }

  .cv-list {
    list-style: none;
  }

  .cv-entry + .cv-entry {
    margin-top: 1.1rem;
  }

  .cv-company {
    display: block;
    font-family: 'Archivo Black', 'Arial Black', sans-serif;
    font-size: 1.05rem;
    line-height: 1.2;
    text-transform: uppercase;
  }

  a.cv-company {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: text-decoration-color 0.2s;
  }

  a.cv-company:hover,
  a.cv-company:focus-visible {
    text-decoration-color: currentColor;
  }

  .cv-sub {
    display: block;
    margin-top: 0.15rem;
    font-style: italic;
    font-size: 1rem;
    line-height: 1.3;
    opacity: 0.7;
  }

  /* ─── with the diamond: pinned section, the tower builds on the right ── */

  :global(.has-diamond) .cv {
    height: calc(100vh + var(--count) * 40vh);
    padding: 0;
  }

  :global(.has-diamond) .cv-pin {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100dvh;
  }

  :global(.has-diamond) .cv-copy {
    position: absolute;
    top: 50%;
    left: max(24px, 8vw);
    width: min(30vw, 420px);
    margin: 0;
    transform: translateY(-50%);
  }

  :global(.has-diamond) .cv-head {
    text-align: left;
    margin-bottom: 2rem;
  }

  /* Entries light up as their slab lands. */
  :global(.has-diamond) .cv-entry {
    opacity: 0.18;
    transition: opacity 0.4s;
  }

  :global(.has-diamond) .cv-entry.is-landed {
    opacity: 0.75;
  }

  :global(.has-diamond) .cv-entry.is-current {
    opacity: 1;
  }

  :global(.has-diamond) .cv-entry.is-current .cv-company::before {
    content: '◆ ';
  }

  /* Narrow screens: the tower takes the screen, only the current entry
     shows, at the bottom. */
  @media (max-aspect-ratio: 23/20) {
    :global(.has-diamond) .cv-copy {
      top: auto;
      bottom: max(5vh, 24px);
      left: 24px;
      right: 24px;
      width: auto;
      transform: none;
    }

    :global(.has-diamond) .cv-head {
      margin-bottom: 0.8rem;
    }

    :global(.has-diamond) .cv-head h2 {
      font-size: 1.6rem;
    }

    :global(.has-diamond) .cv-list {
      position: relative;
      min-height: 4.2rem;
    }

    :global(.has-diamond) .cv-entry {
      position: absolute;
      inset: 0 0 auto;
      margin: 0;
      opacity: 0;
    }

    :global(.has-diamond) .cv-entry.is-landed {
      opacity: 0;
    }

    :global(.has-diamond) .cv-entry.is-current {
      opacity: 1;
    }

    :global(.has-diamond) .cv-copy .more {
      margin: 1rem 0 0;
    }
  }

  :global(.has-diamond) .cv-copy .more {
    margin: 2rem 0 0;
  }
</style>
